{
	"name": "cli-aware",
	"version": "1.0.0",
	"description": "Best-effort detection of whether an HTTP request originated from a CLI tool or a browser",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"sideEffects": false,
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=18.0.0"
	},
	"scripts": {
		"build": "node scripts/build.js",
		"typecheck": "tsc --noEmit",
		"check": "prettier --check .",
		"format": "prettier --write .",
		"test": "vitest run",
		"prepublishOnly": "npm run build && npm test"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Pre1ude0/cli-aware.git"
	},
	"keywords": [
		"cli",
		"browser",
		"user-agent",
		"detection",
		"curl",
		"http"
	],
	"author": "",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/Pre1ude0/cli-aware/issues"
	},
	"homepage": "https://github.com/Pre1ude0/cli-aware#readme",
	"devDependencies": {
		"@types/node": "^26.1.1",
		"prettier": "3.9.5",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
